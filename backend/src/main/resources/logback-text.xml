<included>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSSXXX} | %X{method} | %X{status} | %X{durationMs} | %msg | %X{path} | %X{userAgent} | %-5level | %logger{36} | %thread | %X{callId}%n</pattern>
        </encoder>
    </appender>
</included>
