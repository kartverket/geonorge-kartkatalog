# Oversikt over miljøvariabler for backend. Kopier denne -> .env og sett inn riktige verdier
GEONETWORK_BASE_URL="Base url til der geonetwork kjører"
REGISTER_BASE_URL="Base url til der register kjører"
SOLR_BASE_URL="Base intern url til der solr kjører"
NORGESKART_BASE_URL="Base url til der norgeskart kjører"
NEDLASTING_BASE_URL="Base url til der nedlasting kjører"
GEOID_ISSUER="Base url til der geoid kjører"
GEOID_CLIENT_ID="Geoid client id"
GEOID_CLIENT_SECRET="Geoid client secret"
PUBLIC_BASE_URL="Base url til der public frontendt kjører"
AUTH_PUBLIC_BASE_URL="Public url for auth"
TOKEN_EXCHANGE_URL="Token exchange, kan være hva som helst per nå"
VECTOR_SEARCH_ENABLED=true|false
VERTEX_AI_PROJECT_ID="Gcp project id for dev|prod"