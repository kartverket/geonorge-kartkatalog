{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('.next/dev', { recursive: true, force: true })\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "ts-check": "tsc --noEmit",
    "next-compile": "next build --experimental-build-mode compile",
    "lint": "biome check --error-on-warnings",
    "lint-strict": "biome check --error-on-warnings",
    "lint-fix": "biome check --write ./src",
    "format": "biome format --write",
    "biome-migrate": "biome migrate"
  },
  "dependencies": {
    "@cookieyes/nextjs": "^0.8.1",
    "@kv-designsystem/react": "^1.0.0-alpha.6",
    "@navikt/aksel-icons": "^8.19.1",
    "@oicl/openbridge-webcomponents-react": "^2.0.0",
    "next": "^16.4.0",
    "ol": "^10.11.0",
    "posthog-js": "^1.438.8",
    "posthog-node": "^5.56.1",
    "proj4": "^2.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "xml-js": "^1.6.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "typescript": "^7"
  }
}
