# Oversikt over miljøvariabler for frontend. Kopier denne -> .env og sett inn riktige verdier
API_BASE="Base url til der backend kjører eks. http://localhost:8080"
REGISTER_BASE_URL="Base url til der register kjører"
GEONETWORK_BASE_URL="Base url til der geonetwork kjører"
KATALOG_BASE_URL="Offentlig base url til kartkatalogen, eks. http://localhost:3000"
EDITOR_BASE_URL="Base url til der metadataeditor kjører"
NEXT_PUBLIC_MOCK_AUTH_ENABLED="setter om kan logge inn med tulle auth"
AUTH_BASE_URL="Base url til der autentisering kjører for lokal token ex og mock login"